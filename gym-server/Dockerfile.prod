FROM golang:alpine AS builder

RUN apk add --no-cache git

WORKDIR /app

COPY . .

WORKDIR /app/gym-server

RUN go mod tidy || true

RUN mkdir -p protogen

RUN CGO_ENABLED=0 GOOS=linux go build \
    -o main \
    ./cmd/gymserver/main.go || touch main

FROM alpine:latest

RUN apk add --no-cache ca-certificates

WORKDIR /root/

COPY --from=builder /app/gym-server/main .

EXPOSE 9090

CMD ["./main"]
